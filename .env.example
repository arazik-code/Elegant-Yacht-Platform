# Environment Variables for Bimo Yacht Platform
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/bimo_yacht?retryWrites=true&w=majority"

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# ===========================================
# CLOUDINARY
# ===========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bimo_yacht_uploads

# ===========================================
# WHATSAPP
# ===========================================
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Hello! I'm interested in your luxury yachts.

# WhatsApp Business API (Optional - for future automation)
# Get these from Meta Business Suite > WhatsApp Business Settings
WHATSAPP_BUSINESS_API_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ===========================================
# SITE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SITE_URL=https://bimoyacht.com
NEXT_PUBLIC_SITE_NAME=Bimo Yacht For Sale
NEXT_PUBLIC_COMPANY_EMAIL=info@bimoyacht.com
NEXT_PUBLIC_COMPANY_PHONE=+971 50 123 4567

# ===========================================
# OPTIONAL: ANALYTICS
# ===========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Bimo Yacht <notifications@bimoyacht.com>"
ADMIN_EMAIL=admin@bimoyacht.com

# ===========================================
# CRON JOBS (for daily digest)
# ===========================================
CRON_SECRET=your_secure_random_secret_here
